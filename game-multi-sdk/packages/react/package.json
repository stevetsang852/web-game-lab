{
  "name": "@game-multi-sdk/react",
  "version": "0.1.1",
  "description": "React bindings (Context + Hooks) for game-multi-sdk",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
