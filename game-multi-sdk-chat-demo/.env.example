# Server-side only. Do not prefix these with VITE_ and do not commit real values.
# Copy to .env for `npm run dev` and Docker Compose, or export them in the shell.
TURN_PROVIDER=cloudflare
CF_TURN_KEY_ID=
CF_TURN_KEY_API_TOKEN=
TURN_TTL_SECONDS=3600

# Optional browser origin of the credential service, with no path.
# Leave empty to request same-origin /turn (Vite dev, Vite preview, Docker).
# VITE_TURN_BASE_URL=
